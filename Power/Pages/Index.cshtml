@page
@model IndexModel
@{
    ViewData["Title"] = "Прогноз погоды";
}

<div id="app" class="text-center">
    <div class="container" v-if="tab=='error'">
        <div class="row">
            <div class="col-auto  d-flex flex-column">
                <div class="d-flex flex-column gap-3 p-3 border rounded">
                    <button class="btn btn-primary" :class="loadInProgress==true?'btn-dark':'btn-light'" v-on:click="reloadInfo">Перезагрузить</button>
                </div>
            </div>
            <div class="col">
                <label class="col-form-label" v-if="loadInProgress==false">Произошла ошибка при загрузке данных</label>
                <label class="col-form-label" v-if="loadInProgress==true">Данные загружаются</label>
            </div>
        </div>
    </div>
    <div class="container" v-else>
        <div class="row">
            @*Список кнопок*@
            <div class="col-auto  d-flex flex-column">
                <div class="d-flex flex-column gap-3 p-3 border rounded">
                    <button class="btn btn-primary" :class="tab=='current'?'btn-dark':'btn-light'" v-on:click="openCurrent">Сейчас</button>
                    <button class="btn btn-primary" :class="tab=='forecast'?'btn-dark':'btn-light'" v-on:click="openForecast">Прогноз</button>
                    <button class="btn btn-primary" :class="loadInProgress==true?'btn-dark':'btn-light'" v-on:click="reloadInfo">Обновить</button>
                </div>
            </div>
            <div class="col" v-if="loadInProgress==false">
                @*Погода сейчас*@
                <div class="col d-flex flex-column" v-if="tab=='current'">
                    <div class="d-flex flex-column gap-3 p-3 border rounded">
                        <label class ="col-form-label">Текущая погода<label>
                    </div>
                    <div class="d-flex flex-column gap-3 p-3 border rounded">
                        <div>
                            <label class="col-form-label">Условия: {{this.forecastData!=null?this.forecastData?.current?.condition?.text??"":""}}</label>
                        </div>
                    </div>
                </div>
                @*Прогноз погоды*@
                <div class="col d-flex flex-column" v-if="tab=='forecast'">
                    <div class="d-flex flex-column gap-3 p-3 border rounded">
                        <label class="col-form-label">Прогноз</label>
                    </div>
                    <div v-if="forecastData!=null" class="d-flex flex-column gap-3 p-3 border rounded">
                        <template v-for="item of forecastData.forecast.forecastday">
                            <label class="col-form-label border rounded">{{item.date??""}}</label>
                            <template v-for="item of item.hour">
                                <label class="col-form-label">{{new Date(item.time).toLocaleTimeString()}}</label>
                                <label class="col-form-label">Условия: {{item.condition?.text??""??""}}</label>
                            </template>
                        </template>
                    </div>

                </div>
            </div>
            <div v-else class="row">
                <label class="col-form-label">Данные загружаются</label>
            </div>

        </div>

    </div>

</div>

<script src="~/js/WeatherApp/WeatherApp.js" asp-append-version="true"></script>